#%RAML 1.0
title: customer-dp-exp-api
version: v1
documentation:
  - title: Customer, Order & Delivery Partner Experience API
    content: This Experience API provides a unified interface for customer-related
      operations, order management, and delivery partner assignment details.
      It interacts with the underlying Process APIs to retrieve, create, and
      update information related to customers, orders, and delivery partners.

traits:
  errResponse: !include exchange_modules/635159a8-be44-4ed5-a886-bb461c9661c6/trait-error-response/1.0.0/trait-error-response.raml

/api:
  /v1:
    /customers:
      is: [errResponse]
      get:
        description: Retrieve all customers from Salesforce
        responses:
          200:
            body:
              application/json:
                example: !include /Examples/allCustomersDetails.json
      post:
        description: Create a new customer
        body:
          application/json:
            example: !include Examples/customerDetails.json
        responses:
          201:
            body:
              application/json:
                example: !include Examples/customerPostResponse.json

      /{customerId}:
        uriParameters:
          customerId:
            type: string
            description: Unique Customer ID in Salesforce
        get:
          description: Retrieve customer details from Salesforce
          responses:
            200:
              body:
                application/json:
                  example: !include /Examples/customerDetails.json
        put:
          description: Update a specific customer record
          body:
            application/json:
              example: !include Examples/customerPutRequest.json
          responses:
            200:
              body:
                application/json:
                  example: !include Examples/customerPutResponse.json

        delete:
          description: Delete a specific customer record
          responses:
            200:
              body:
                application/json:
                  example: !include Examples/customerDeleteResponse.json
    
        /orders:
          get:
            description: Retrieve all orders of the customer from Salesforce
            responses:
              200:
                body:
                  application/json:
                    example: !include /Examples/getAllCustomerOrders.json

    /deliveryPartners:
      is: [errResponse]
      get:
          description: Retrieve all delivery partners from Salesforce
          responses:
            200:
              body:
                application/json:
                  example: !include /Examples/getAllDeliveryPartners.json

      post:
        description: Create a new delivery partner
        body:
          application/json:
            example: !include Examples/deliveryPartnerPostRequest.json
        responses:
          201:
            body:
              application/json:
                example: !include Examples/deliveryPartnerPostResponse.json
     
      /{partnerId}:
        uriParameters:
          partnerId:
            type: string
            description: Unique partner ID in Salesforce.
        get:
          description: Retrieve delivery partner details from Salesforce
          responses:
            200:
              body:
                application/json:
                  example: !include /Examples/getDeliveryPartnerDetails.json

        put:
          description: Update a specific delivery partner record
          body:
            application/json:
              example: !include Examples/deliveryPartnerPutRequest.json
          responses:
            200:
              body:
                application/json:
                  example: !include Examples/deliveryPartnerPutResponse.json

        delete:
          description: Delete a specific customer record
          body:
            application/json:
              example: !include Examples/deliveryPartnerDeleteResponse.json        
        
        /orders:
          get:
            description: Retrieve all orders assigned to the delivery partner from Salesforce
            responses:
              200:
                body:
                  application/json:
                    example: !include /Examples/getAllAssignedOrders.json

    /orders:
      is: [errResponse]
      get:
          description: Retrieve all orders from Salesforce
          responses:
            200:
              body:
                application/json:
                  example: !include /Examples/getAllOrders.json

      post:
        description: Create a new order record in Salesforce
        body:
          application/json:
            example: !include Examples/orderPostRequest.json
        responses:
          201:
            body:
              application/json:
                example: !include Examples/orderPostResponse.json
      /{orderId}:
        uriParameters:
          orderId:
            type: string
            description: Unique Order ID in Salesforce
        get:
          description: Retrieve order details by ID from Salesforce
          responses:
            200:
              body:
                application/json:
                  example: !include /Examples/getOrderDetails.json
        patch:
          description: Update partial order info
          body:
            application/json:
              example: !include Examples/orderPatchRequest.json
          responses:
            200:
              body:
                application/json:
                  example: !include Examples/orderPatchResponse.json
        
        delete:
          description: Delete an order by order ID.
          responses:
            200:
              body:
                application/json:
                  example: !include Examples/orderCancelledResponse.json  
